// Prisma şeması — PostgreSQL
// Not: Ücret bilgisi SUNUCUDA belirlenir (config.js PRICING).
// İstemciden gelen fiyat hiçbir yerde kullanılmaz.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /// Profil adresi: /u/<handle>
  handle       String   @unique
  displayName  String
  bio          String   @default("")
  avatarKey    String?
  /// Ücretsiz gerçek AI proje hakkı. AI kullanıcının kendi anahtarıyla
  /// çalıştığı için bu sayaç sunucu maliyeti doğurmaz, yalnızca üyelik kapısıdır.
  freePasses   Int      @default(1)
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  membership Membership?
  projects   Project[]
  sessions   Session[]
  /// Bu kullanıcıyı takip edenler (Follow.followingId = user.id)
  followers  Follow[]   @relation("following")
  /// Bu kullanıcının takip ettikleri (Follow.followerId = user.id)
  following  Follow[]   @relation("follower")
  payments   Payment[]
  likes      Like[]
  comments   Comment[]
  /// Bu kullanıcının açtığı şikayetler
  reports        Report[]  @relation("reporter")
  /// Şikayeti inceleyip kapatan yönetici
  resolvedReports Report[] @relation("resolver")
}

model Membership {
  id                   String    @id @default(cuid())
  userId               String    @unique
  /// LIFETIME (ömür boyu, tek ödeme) | MONTHLY (aylık abonelik)
  plan                 String
  /// ACTIVE | EXPIRED | CANCELED
  status               String    @default("ACTIVE")
  priceCents           Int
  currency             String    @default("usd")
  stripeCustomerId     String?
  stripeSessionId      String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  lifetimeAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  /// Stripe event/session kimliği — tekrar işlemeyi engeller (idempotency)
  providerRef String   @unique
  /// LIFETIME | SUBSCRIPTION | RENEWAL
  kind        String
  amountCents Int
  currency    String   @default("usd")
  raw         Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Project {
  id         String   @id @default(cuid())
  ownerId    String
  title      String
  /// Herkese açık kısa özet (duvarda görünür)
  summary    String
  /// ÜYE OLMAYAN İSTEMCİYE ASLA GÖNDERİLMEZ — API sorgularında
  /// isMember=false iken hiçbir select listesine dahil edilmez.
  promptBody String
  /// Üretilen proje dokümanı (malzeme listesi, adımlar, kod)
  guideJson  Json?
  isShared   Boolean  @default(false)
  sharedAt   DateTime?
  /// Moderasyon: gizlenen proje duvardan düşer (kayıt silinmez).
  hiddenAt   DateTime?
  /// Türkçe harf duyarsız arama için başlık+özet küçültülmüş kopyası
  /// (yazılırken `foldTR` ile üretilir, sorgu sırasında katlanmaz).
  searchText String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner  User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images ProjectImage[]
  likes  Like[]
  comments Comment[]

  @@index([isShared, sharedAt])
  @@index([ownerId, createdAt])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  /// MinIO/S3 nesne anahtarı
  objectKey String
  width     Int?
  height    Int?
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

/// Bir kullanıcının bir projeye verdiği tek beğeni.
model Like {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId, createdAt])
}

/// Proje yorumu. Prompt içeriği gibi herkese açıktır — yazmak üyelere açıktır.
model Comment {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  body      String
  /// Moderasyon: gizlenen yorum listeden düşer (yazarı veya proje sahibi
  /// ya da yönetici gizleyebilir; silmekten ayrı, geri alınabilir).
  hiddenAt  DateTime?
  hiddenById String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// Kullanıcı şikâyeti. `targetId` serbest bırakılmıştır: hedef silinse bile
/// şikâyet kaydı (kim, neyi, ne zaman bildirdi) korunmalıdır.
model Report {
  id           String    @id @default(cuid())
  reporterId   String
  /// COMMENT | PROJECT | USER
  targetType   String
  targetId     String
  /// SPAM | HARASSMENT | OFF_TOPIC | UNSAFE | OTHER
  reason       String
  details      String    @default("")
  /// OPEN | RESOLVED | DISMISSED
  status       String    @default("OPEN")
  resolvedById String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  reporter   User  @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("resolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  /// Aynı kullanıcı aynı hedefi iki kez bildiremez (spam koruması)
  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  /// sha256(token) — ham token sadece istemcide tutulur
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}