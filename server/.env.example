# Kopyala: cp server/.env.example server/.env  (sonra parolaları değiştir)
# Bu dosya .gitignore'dadır; asla commit edilmez.

NODE_ENV=production
# Reverse proxy arkasında (Traefik) gerçek IP'yi görmek için:
TRUST_PROXY=true

# Statik sitenin origin'i. Virgülle birden fazla.
# Yerel: dist/ dosyasını sunan yerel adres.
APP_ORIGIN=http://localhost:8000,https://proacademycomtr.github.io

# Bu domain VDS'te Traefik kuralı ve dönüş adresleri için kullanılır.
DOMAIN=arduino.proacademy.com.tr
API_PORT=4021

# Oturum ömrü (gün)
SESSION_DAYS=30

# ── Fiyatlandırma: ilk 1000 kişi ömür boyu $1, sonra aylık ──────────────
PRICING_LIFETIME_LIMIT=1000
PRICING_LIFETIME_CENTS=100
PRICING_MONTHLY_CENTS=100
PRICING_CURRENCY=usd

# ── Stripe (ABD şirketi) ────────────────────────────────────────────────
# Test anahtarlarıyla başla: sk_test_... / whsec_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Dashboard > Products > Prices içinden oluşturulacak Price kimlikleri.
# Lifetime: one-time payment, Monthly: recurring monthly
STRIPE_PRICE_LIFETIME=
STRIPE_PRICE_MONTHLY=

# ── Veritabanı (docker-compose tarafından doldurulur) ─────────────────────
DATABASE_URL=postgresql://arlo:arlo_dev_password@127.0.0.1:5432/arlo_db
POSTGRES_PASSWORD=arlo_dev_password

# ── Görsel deposu (MinIO) ───────────────────────────────────────────────
S3_BUCKET=arlo-gorseller
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/arlo-gorseller
MINIO_ROOT_USER=arlo
MINIO_ROOT_PASSWORD=arlo_dev_password
S3_FORCE_PATH_STYLE=true

# Gerçek bir sır üret:  openssl rand -hex 32
JWT_SECRET=