// Prisma şeması — PostgreSQL
// Not: Ücret bilgisi SUNUCUDA belirlenir (config.js PRICING).
// İstemciden gelen fiyat hiçbir yerde kullanılmaz.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /// Profil adresi: /u/<handle>
  handle       String   @unique
  displayName  String
  bio          String   @default("")
  avatarKey    String?
  /// Ücretsiz gerçek AI proje hakkı. AI kullanıcının kendi anahtarıyla
  /// çalıştığı için bu sayaç sunucu maliyeti doğurmaz, yalnızca üyelik kapısıdır.
  freePasses   Int      @default(1)
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  membership Membership?
  projects   Project[]
  sessions   Session[]
  /// Bu kullanıcıyı takip edenler (Follow.followingId = user.id)
  followers  Follow[]   @relation("following")
  /// Bu kullanıcının takip ettikleri (Follow.followerId = user.id)
  following  Follow[]   @relation("follower")
  payments   Payment[]
}

model Membership {
  id                   String    @id @default(cuid())
  userId               String    @unique
  /// LIFETIME (ömür boyu, tek ödeme) | MONTHLY (aylık abonelik)
  plan                 String
  /// ACTIVE | EXPIRED | CANCELED
  status               String    @default("ACTIVE")
  priceCents           Int
  currency             String    @default("usd")
  stripeCustomerId     String?
  stripeSessionId      String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  lifetimeAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  /// Stripe event/session kimliği — tekrar işlemeyi engeller (idempotency)
  providerRef String   @unique
  /// LIFETIME | SUBSCRIPTION | RENEWAL
  kind        String
  amountCents Int
  currency    String   @default("usd")
  raw         Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Project {
  id         String   @id @default(cuid())
  ownerId    String
  title      String
  /// Herkese açık kısa özet (duvarda görünür)
  summary    String
  /// ÜYE OLMAYAN İSTEMCİYE ASLA GÖNDERİLMEZ — API sorgularında
  /// isMember=false iken hiçbir select listesine dahil edilmez.
  promptBody String
  /// Üretilen proje dokümanı (malzeme listesi, adımlar, kod)
  guideJson  Json?
  isShared   Boolean  @default(false)
  sharedAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner  User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images ProjectImage[]

  @@index([isShared, sharedAt])
  @@index([ownerId, createdAt])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  /// MinIO/S3 nesne anahtarı
  objectKey String
  width     Int?
  height    Int?
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  /// sha256(token) — ham token sadece istemcide tutulur
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}